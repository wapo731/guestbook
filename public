<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>GitLab Guestbook</title>
</head>
<body>
    <h1>Welcome to my Guestbook!</h1>
    
    <!-- Sign Form -->
    <form id="guestbook-form">
        <input type="text" id="name" placeholder="Your Name" required><br><br>
        <textarea id="message" placeholder="Your Message" required></textarea><br><br>
        <button type="submit">Sign Guestbook</button>
    </form>

    <h2>Recent Signatures</h2>
    <div id="entries">Loading entries...</div>

    <script>
        // Replace with your GitLab Project ID
        const PROJECT_ID = "YOUR_PROJECT_ID"; 
        
        // Fetch signatures from GitLab Issues
        async function loadEntries() {
            const response = await fetch(`https://gitlab.com{PROJECT_ID}/issues?labels=guestbook`);
            const issues = await response.json();
            const container = document.getElementById('entries');
            container.innerHTML = issues.map(issue => `
                <p><strong>${issue.title}</strong>: ${issue.description}</p>
            `).join('') || '<p>No signatures yet!</p>';
        }

        // Submit signature via GitLab API (Requires a public form or a backend proxy)
        document.getElementById('guestbook-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const title = document.getElementById('name').value;
            const description = document.getElementById('message').value;

            // Note: For a completely public frontend, you'll want to route this 
            // to a serverless function or an external database to protect api keys.
            alert('Form submitted! (Connect your API token/backend to write to issues)');
        });

        loadEntries();
    </script>
</body>
</html>
